# Copier en `.env` (ignoré par git). Aucune valeur réelle ne doit entrer dans le dépôt.

# Postgres (dev : compose.yml ; prod : service Postgres Dokploy)
DATABASE_URL=postgres://bien:bien@localhost:5433/bien

# Signature du cookie de session, 32 caractères minimum (openssl rand -base64 48)
SESSION_SIGNING_SECRET=

# Seed des deux foyers (scripts/seed.mjs). Codes : 6 caractères A-Z 0-9.
# Le foyer réel : ses prénoms ne doivent jamais figurer dans le dépôt, ils viennent d'ici.
FOYER_REEL_CODE=
FOYER_REEL_PERSONNES=Prénom1,Prénom2
# Le foyer de test, remis à zéro par `npm run db:reset-test`.
FOYER_TEST_CODE=
FOYER_TEST_PERSONNES=Camille,Sacha

# Développement seulement : fixe le jour courant (YYYY-MM-DD) pour rejouer un dimanche.
# BIEN_AUJOURDHUI=2026-09-13
